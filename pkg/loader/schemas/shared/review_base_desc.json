{{- define "review_base_desc" -}}
{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		{{template "shared_approved"}}
		"should_reset": {
			"type": "boolean"
		},
		"reset_reason": {
			"type": "string",
			"description": "short explanation of why prior context is no longer trustworthy"
		},
		"issues": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					{{- template "shared_issue_item" . -}}
				},
				"required": [
					"severity",
					"severity_reason",
					"category",
					"message",
					"next_actions"
				]
			},
			"description": "list of issues found"
		}
	},
	"required": [
		"approved",
		"approved_confidence",
		"approved_reason",
		"resolved_issues",
		"should_reset",
		"reset_reason",
		"issues"
	]
}
{{- end -}}
